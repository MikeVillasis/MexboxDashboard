<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ═══ Games blade: Xbox signature green ═══ -->
    <Color x:Key="GamesPrimary">#FF107C10</Color>
    <Color x:Key="GamesGlow">#FF77BB00</Color>
    <Color x:Key="GamesNeon">#FF9BF00B</Color>
    <Color x:Key="GamesForestTop">#FF0E3A0E</Color>
    <Color x:Key="GamesForestBottom">#FF010A01</Color>

    <!-- ═══ Media blade: electric aero blue ═══ -->
    <Color x:Key="MediaPrimary">#FF0072CE</Color>
    <Color x:Key="MediaCyan">#FF00A4EF</Color>
    <Color x:Key="MediaDeepTop">#FF06284A</Color>
    <Color x:Key="MediaDeepBottom">#FF010812</Color>

    <!-- ═══ System blade: liquid silver & amber ═══ -->
    <Color x:Key="SystemSilver">#FFD2D2D2</Color>
    <Color x:Key="SystemCarbon">#FF2B2B2B</Color>
    <Color x:Key="SystemAmber">#FFFFB900</Color>
    <Color x:Key="SystemDeepTop">#FF34343A</Color>
    <Color x:Key="SystemDeepBottom">#FF0B0B0D</Color>

    <SolidColorBrush x:Key="SystemCarbonBrush" Color="{StaticResource SystemCarbon}" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAmberBrush" Color="{StaticResource SystemAmber}" po:Freeze="True" />

    <!-- Swap for "Convection" (or any licensed look-alike) once it is installed / embedded under Assets\Fonts. -->
    <FontFamily x:Key="DashFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Top-half specular highlight used by pills, list selection and round buttons: rgba(255,255,255,.25) with a hard edge at 50%. -->
    <LinearGradientBrush x:Key="SpecularGloss" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#40FFFFFF" Offset="0.48" />
        <GradientStop Color="#00FFFFFF" Offset="0.5" />
    </LinearGradientBrush>

    <!-- Per-blade selection fills (picked up via DynamicResource "ListHighlightBrush" in each view). -->
    <LinearGradientBrush x:Key="GamesHighlight" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF9BF00B" Offset="0" />
        <GradientStop Color="#FF77BB00" Offset="0.5" />
        <GradientStop Color="#FF2E7D0A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MediaHighlight" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF6FD3FF" Offset="0" />
        <GradientStop Color="#FF00A4EF" Offset="0.5" />
        <GradientStop Color="#FF0058A8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SystemHighlight" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFFFD866" Offset="0" />
        <GradientStop Color="#FFFFB900" Offset="0.5" />
        <GradientStop Color="#FFC98500" Offset="1" />
    </LinearGradientBrush>

    <!-- Pill / round button bodies. -->
    <LinearGradientBrush x:Key="GamesPill" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF8BDD1A" Offset="0" />
        <GradientStop Color="#FF3FA013" Offset="0.5" />
        <GradientStop Color="#FF0B5E0B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MediaPill" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF4CC6FF" Offset="0" />
        <GradientStop Color="#FF0084DA" Offset="0.5" />
        <GradientStop Color="#FF004C94" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SystemPill" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF5A5A5E" Offset="0" />
        <GradientStop Color="#FF2B2B2B" Offset="0.5" />
        <GradientStop Color="#FF141414" Offset="1" />
    </LinearGradientBrush>

    <!-- Jewel case top band. -->
    <LinearGradientBrush x:Key="CaseBandBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF4FC14F" Offset="0" />
        <GradientStop Color="#FF107C10" Offset="0.55" />
        <GradientStop Color="#FF0A5A0A" Offset="1" />
    </LinearGradientBrush>

    <!-- Controller face-button glyphs (generic colours, no logos). -->
    <RadialGradientBrush x:Key="GlyphA" GradientOrigin="0.35,0.25" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75" po:Freeze="True">
        <GradientStop Color="#FFB6F27A" Offset="0" />
        <GradientStop Color="#FF4FAE1C" Offset="0.6" />
        <GradientStop Color="#FF2A6E0A" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlyphB" GradientOrigin="0.35,0.25" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75" po:Freeze="True">
        <GradientStop Color="#FFFF9A9A" Offset="0" />
        <GradientStop Color="#FFD72A2A" Offset="0.6" />
        <GradientStop Color="#FF8A1010" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlyphX" GradientOrigin="0.35,0.25" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75" po:Freeze="True">
        <GradientStop Color="#FF9FD2FF" Offset="0" />
        <GradientStop Color="#FF2A82DA" Offset="0.6" />
        <GradientStop Color="#FF0F4E96" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlyphY" GradientOrigin="0.35,0.25" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75" po:Freeze="True">
        <GradientStop Color="#FFFFF0A0" Offset="0" />
        <GradientStop Color="#FFF2C200" Offset="0.6" />
        <GradientStop Color="#FFA07A00" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="GlyphShoulder" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF707070" Offset="0" />
        <GradientStop Color="#FF303030" Offset="0.55" />
        <GradientStop Color="#FF181818" Offset="1" />
    </LinearGradientBrush>

    <!-- CRT-style scanlines: 1 dark line every 3 px. -->
    <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H4 V3 H0 Z" />
                <GeometryDrawing Brush="#FF000000" Geometry="M0,0 H4 V1 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
