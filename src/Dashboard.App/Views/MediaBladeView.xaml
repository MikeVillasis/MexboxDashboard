<UserControl x:Class="Dashboard.App.Views.MediaBladeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <StaticResource x:Key="ListHighlightBrush" ResourceKey="MediaHighlight" />
        <StaticResource x:Key="PillBrush" ResourceKey="MediaPill" />
        <RadialGradientBrush x:Key="PillGlowBrush">
            <GradientStop Color="#9900A4EF" Offset="0.55" />
            <GradientStop Color="#0000A4EF" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="now playing" Style="{StaticResource BladeTitle}" />
            <TextBlock Text="{Binding SourceApp}" Style="{StaticResource BladeSubtitle}" />
        </StackPanel>

        <!-- Active session -->
        <!-- Centred in the blade at 1.5x; the Viewbox only scales down, so small windows still fit. -->
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,0,0,40"
                 Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="54">
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                </StackPanel.LayoutTransform>
                <!-- Glossy album frame over a blurred ambient copy of the art -->
                <Grid Width="380" Height="380">
                    <Rectangle Margin="-36" Opacity="0.6" RadiusX="40" RadiusY="40" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance" />
                        </Rectangle.Effect>
                    </Rectangle>
                    <Border CornerRadius="12" BorderBrush="#B3FFFFFF" BorderThickness="2" Background="#40000000">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="96" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="10" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4DFFFFFF" Offset="0" />
                                        <GradientStop Color="#14FFFFFF" Offset="0.4" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.41" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Width="440" Margin="44,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="36" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Artist}" FontSize="22" Opacity="0.9" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Album}" FontSize="17" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,34,0,0">
                        <Button Content="&#xE892;" Style="{StaticResource RoundGlossButton}" Click="OnPrevious"
                                IsEnabled="{Binding CanGoPrevious}" ToolTip="Previous (X)" />
                        <Button Content="{Binding PlayPauseGlyph}" Style="{StaticResource RoundGlossButton}" Click="OnPlayPause"
                                Width="84" Height="84" FontSize="30" Margin="18,0" ToolTip="Play / pause (A)" />
                        <Button Content="&#xE893;" Style="{StaticResource RoundGlossButton}" Click="OnNext"
                                IsEnabled="{Binding CanGoNext}" ToolTip="Next (Y)" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Viewbox>

        <!-- Nothing playing -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasSession, Converter={StaticResource BoolToVisInverted}}">
            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="72" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="nothing playing" FontSize="32" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="start music or a video in any app (spotify, a browser, vlc…) and it shows up here."
                       FontSize="16" Opacity="0.75" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
        </StackPanel>
    </Grid>
</UserControl>
