<UserControl x:Class="Dashboard.App.Views.GamesBladeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dashboard.App.Controls">
    <UserControl.Resources>
        <StaticResource x:Key="ListHighlightBrush" ResourceKey="GamesHighlight" />
        <StaticResource x:Key="PillBrush" ResourceKey="GamesPill" />
        <RadialGradientBrush x:Key="PillGlowBrush">
            <GradientStop Color="#999BF00B" Offset="0.55" />
            <GradientStop Color="#009BF00B" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="560" />
            <ColumnDefinition Width="1.35*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
            <TextBlock Text="games library" Style="{StaticResource BladeTitle}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource BladeSubtitle}" />
        </StackPanel>

        <!-- Library list (virtualized, recycled) -->
        <ListBox x:Name="GameList" Grid.Row="1"
                 Style="{StaticResource BladeListBox}"
                 ItemContainerStyle="{StaticResource BladeListItem}"
                 ItemsSource="{Binding Games}"
                 SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                 SelectionChanged="OnSelectionChanged"
                 PreviewMouseMove="OnListMouseMove"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:CoverArt Width="40" Height="56" Compact="True" DecodeWidth="80"
                                           ImagePath="{Binding CoverPath}" Title="{Binding Title}" />
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="19" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PlatformLabel}" FontSize="13" Opacity="0.72" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Play" Click="OnLaunchClick" />
                    <MenuItem Header="Set Custom Cover Art…" Click="OnSetCoverClick" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasGames, Converter={StaticResource BoolToVisInverted}}">
            <TextBlock Text="no games yet" FontSize="32" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyHint}" FontSize="16" Opacity="0.75" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
        </StackPanel>

        <!-- Focused game preview: large cover centred in the column, with a floor reflection.
             The Viewbox only ever scales down, so smaller windows still fit the whole group. -->
        <Viewbox Grid.Row="1" Grid.Column="1" Margin="40,0,0,0"
                 Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 DataContext="{Binding SelectedGame}"
                 Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <controls:CoverArt x:Name="PreviewCover" Width="600" Height="850" DecodeWidth="400"
                                       ImagePath="{Binding CoverPath}" Title="{Binding Title}" Platform="{Binding PlatformLabel}"
                                       AllowDrop="True" DragOver="OnCoverDragOver" Drop="OnCoverDrop"
                                       MouseRightButtonUp="OnCoverRightClick"
                                       ToolTip="Drop an image here, press Y, or right-click to set custom cover art" />

                    <!-- Mirror of the cover's bottom 20 % (170 of 850 px), flipped inside the brush and fading out.
                         Static brush: re-rendered only when the cover changes. -->
                    <Rectangle Width="600" Height="170" Margin="0,6,0,0" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding ElementName=PreviewCover}" Stretch="Fill"
                                         ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0.8,1,0.2">
                                <VisualBrush.RelativeTransform>
                                    <ScaleTransform ScaleY="-1" CenterY="0.5" />
                                </VisualBrush.RelativeTransform>
                            </VisualBrush>
                        </Rectangle.Fill>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#55000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </StackPanel>

                <StackPanel Width="380" Margin="44,0,0,176" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="40" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details}" FontSize="19" Opacity="0.75" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Button Content="play" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                            FontSize="32" Padding="72,18" Margin="0,36,0,0" Click="OnLaunchClick" />
                </StackPanel>
            </StackPanel>
        </Viewbox>

        <!-- Persistent "now playing" pill (bound to the shared media view model) -->
        <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                DataContext="{Binding Media}"
                Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}"
                CornerRadius="30" Padding="8,8,10,8" BorderBrush="#80FFFFFF" BorderThickness="1"
                MaxWidth="420">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E0005BA8" Offset="0" />
                    <GradientStop Color="#E0003060" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" CornerRadius="24" Background="{StaticResource SpecularGloss}" Margin="-6" IsHitTestVisible="False" />
                <Ellipse Width="44" Height="44" Stroke="#99FFFFFF" StrokeThickness="1">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Width="44" Height="44" FontSize="16" Padding="0"
                        Style="{StaticResource RoundGlossButton}" Background="{StaticResource MediaPill}"
                        Content="{Binding PlayPauseGlyph}" Click="OnNowPlayingToggle" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
